# Normalize line endings. The repo had drifted into a mix of CRLF and LF
# files (a Windows checkout plus tooling that wrote LF), which made diffs
# on some files show as whole-file rewrites for a one-line change.
#
# Text files are stored LF in the repository. Git still checks them out
# with whatever your platform wants, so this changes nothing about editing
# on Windows -- it just stops the working-copy line ending from leaking
# into commits.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binary -- never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.db    binary
