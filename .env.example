# Copy this file to `.env` and fill it in. `.env` is gitignored; this
# template is not, so never put a real token in here.

# ----------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------

# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=

# ----------------------------------------------------------------------
# Core options
# ----------------------------------------------------------------------

# Prefix for legacy (non-slash) commands. The bot is entirely slash
# commands and components, so this is effectively unused.
COMMAND_PREFIX=!

# SQLAlchemy connection string. Defaults to a local SQLite file in the
# project root, which is fine for a test server.
DATABASE_URL=sqlite:///Cascadebot.db

# Set to 1 for verbose debug logging.
DEBUG=0

# Dev-mode guild command syncing: DEV_MODE=True syncs slash commands
# instantly to SERVER_ID only, instead of waiting on Discord's global
# propagation (up to an hour). Recommended while testing. Set
# DEV_MODE=False and clear SERVER_ID to run in multiple servers.
DEV_MODE=True
SERVER_ID=

# Discord user IDs (comma-separated) allowed to use /admin_boosterkit
# regardless of server permissions. Server Administrators can always use
# it, so this is for bot owners testing in servers they don't admin.
ADMIN_USER_IDS=

# ----------------------------------------------------------------------
# Top.gg voting (optional -- powers /vote)
# ----------------------------------------------------------------------
# Leave TOPGG_TOKEN blank and everything still works; /vote simply
# reports that voting isn't set up, and no requests are ever made.
#
# To enable: list the bot on https://top.gg, wait for approval, then open
# your listing's "Integrations & API" tab (older listings call it
# "Webhooks") and copy the API token here. No webhook URL or public
# hosting is required -- the bot polls top.gg when a player runs /vote.
TOPGG_TOKEN=

# Only needed if the top.gg listing isn't for this bot's own application
# ID, which is unusual. Leave blank to use the bot's own ID.
TOPGG_BOT_ID=
